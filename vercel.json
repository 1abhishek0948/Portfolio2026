{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "abhishek-thakur.com.np"
        }
      ],
      "destination": "https://www.abhishek-thakur.com.np/$1",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/web-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/web-development/",
      "destination": "/",
      "permanent": true
    }
  ]
}
